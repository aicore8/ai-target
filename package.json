{
  "name": "ai-target",
  "version": "0.2.5",
  "private": true,
  "description": "Targeting: markers on what you can interact with, ox_target compatible",
  "license": "GPL-3.0-only",
  "author": {
    "name": "TGIANN"
  },
  "repository": "github:aicore8/ai-target",
  "type": "module",
  "fxDependencies": [
    "/onesync",
    "ai-core"
  ],
  "scripts": {
    "lint": "oxlint --ignore-pattern \"dist/**\"",
    "format": "prettier --write .",
    "dev": "bun tsdown -- --watch",
    "build": "bun run --cwd web build && bun tsdown -- && aicore-client-errors dist/client.js",
    "typecheck": "tsc --noEmit -p resource/client/tsconfig.json",
    "webdev": "bun run --cwd web dev"
  },
  "dependencies": {
    "@aicore8/lib": "workspace:*",
    "@aicore8/shared": "workspace:*"
  },
  "devDependencies": {
    "@aicore8/build": "workspace:*",
    "@citizenfx/client": "latest",
    "@citizenfx/server": "latest",
    "@types/bun": "latest",
    "@types/node": "^22",
    "fast-glob": "^3.3.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "oxlint": "^1.66.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  },
  "fxProvide": [
    "ox_target"
  ]
}
